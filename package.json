{
  "name": "dh-ai-african-studies-2026",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "test:links": "node tests/link-check.mjs",
    "test:bundle": "node tests/bundle-budget.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:images": "node scripts/optimize_images.mjs",
    "og:image": "node scripts/make_og_image.mjs",
    "fetch:references": "node scripts/python.mjs scripts/fetch_references.py",
    "build:paper": "npm run export:epub && vite build",
    "export:epub": "node scripts/export-paper-epub.mjs",
    "test:python": "node scripts/python.mjs -B -m unittest discover -s tests/python -p test_*.py",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:static": "node tests/static-content.mjs",
    "check:epub": "node scripts/export-paper-epub.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "globals": "^17.13.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "exifr": "^7.1.3",
    "github-slugger": "^2.0.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "~6.11.2",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0"
  }
}
