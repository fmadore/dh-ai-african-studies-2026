{
  "name": "dh-ai-african-studies-2026",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "test:links": "node tests/link-check.mjs",
    "test:bundle": "node tests/bundle-budget.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:images": "node scripts/optimize_images.mjs",
    "og:image": "node scripts/make_og_image.mjs",
    "fetch:references": "node scripts/python.mjs scripts/fetch_references.py",
    "build:paper": "npm run export:epub && vite build",
    "export:epub": "node scripts/export-paper-epub.mjs",
    "test:python": "node scripts/python.mjs -B -m unittest discover -s tests/python -p test_*.py",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "test:static": "node tests/static-content.mjs",
    "check:epub": "node scripts/export-paper-epub.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "exifr": "^7.1.3",
    "flowbite": "^4.0.2",
    "globals": "^17.14.0",
    "htmlparser2": "^12.0.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "d3-drag": "^3.0.1",
    "d3-force": "^3.0.1",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "github-slugger": "^2.0.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "~6.16.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
